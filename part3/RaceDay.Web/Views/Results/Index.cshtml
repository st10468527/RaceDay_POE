@model IEnumerable<RaceDay.Web.Models.ResultResponseDto>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">
    <!-- Hero Banner -->
    <div class="hero-section text-center text-md-start d-md-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold mb-2"><i class="bi bi-award-fill text-warning me-2"></i>My Race Results</h1>
            <p class="lead text-slate-300 mb-0">Track your personal finishing times, categories, and past event performance.</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="py-3 ps-4">Event Name</th>
                            <th class="py-3">Category</th>
                            <th class="py-3">Finish Time</th>
                            <th class="py-3">Position</th>
                            <th class="py-3 pe-4 text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@result.EventName</td>
                                <td><span class="badge bg-light text-dark border">@result.CategoryName</span></td>
                                <td>
                                    <span class="font-monospace fw-bold text-secondary">
                                        <i class="bi bi-stopwatch me-1"></i>@result.FinishTime
                                    </span>
                                </td>
                                <td>
                                    @if (result.Position.HasValue)
                                    {
                                        <span class="badge bg-success px-2 py-1">
                                            <i class="bi bi-trophy-fill me-1"></i> #@result.Position
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pending</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <span class="badge bg-primary-subtle text-primary fw-semibold">Completed</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light text-center py-5 shadow-sm border rounded-3">
            <i class="bi bi-journal-x display-4 text-muted mb-3 d-block"></i>
            <h5 class="text-dark fw-bold">No Results Recorded Yet</h5>
            <p class="text-muted mb-0">You haven't completed any races or results haven't been published by organisers yet.</p>
        </div>
    }
</div>